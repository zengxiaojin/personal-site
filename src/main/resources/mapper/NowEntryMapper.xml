<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jince.site.mapper.NowEntryMapper">

	<sql id="columns">
		id, body_md, created_at, updated_at
	</sql>

	<select id="findLatest" resultType="NowEntry">
		SELECT <include refid="columns"/>
		FROM now_entries
		ORDER BY created_at DESC, id DESC
		LIMIT 1
	</select>

	<select id="findAll" resultType="NowEntry">
		SELECT <include refid="columns"/>
		FROM now_entries
		ORDER BY created_at DESC, id DESC
	</select>

	<select id="findById" resultType="NowEntry">
		SELECT <include refid="columns"/>
		FROM now_entries
		WHERE id = #{id}
	</select>

	<insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
		INSERT INTO now_entries (body_md)
		VALUES (#{bodyMd})
	</insert>

	<update id="update">
		UPDATE now_entries
		SET body_md = #{bodyMd},
		    updated_at = now()
		WHERE id = #{id}
	</update>

	<delete id="delete">
		DELETE FROM now_entries
		WHERE id = #{id}
	</delete>

</mapper>
